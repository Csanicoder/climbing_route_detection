{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hold Data Input Definition",
  "type": "object",
  "required": ["holds"],
  "properties": {
    "holds": {
      "type": "array",
      "items": {
      "$ref": "#/$defs/hold"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "additionalProperties": false
    },
    "bbox": {
      "description": "Used for bounding boxes and lines (x1, y1) to (x2, y2)",
      "type": "object",
      "required": ["x1", "y1", "x2", "y2"],
      "properties": {
        "x1": { "type": "number" }, "y1": { "type": "number" },
        "x2": { "type": "number" }, "y2": { "type": "number" }
      },
      "additionalProperties": false
    },

    "hold": {
      "type": "object",
      "required": ["centroid", "bbox", "hold_class", "cut_mask"],
      "properties": {
        "centroid": { "$ref": "#/$defs/point"},
        "bbox": { "$ref": "#/$defs/bbox"},
        "hold_class": {"type": "integer"},
        "cut_mask": {
          "type": "array",
          "items": {"type": "boolean"}
        }
      },
      "additionalProperties": false
    }
  }
}
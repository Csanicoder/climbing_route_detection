        </mxCell>
        <mxCell id="p8XZSyLTVqJCuMCk9yrC-40" value="&lt;font&gt;&lt;b&gt;Data Structure:&lt;/b&gt; Array&lt;/font&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font&gt;N items, each representing a hold.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;Camera is stationary, one global array for all frames. Using indexes as unique identifiers&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font&gt;Hold data:&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;- Centerpoint&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;- Bbox&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;- Class&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="p8XZSyLTVqJCuMCk9yrC-39" vertex="1">
          <mxGeometry x="10" y="30" width="260" height="340" as="geometry" />
        </mxCell>
        <mxCell id="p8XZSyLTVqJCuMCk9yrC-48" value="Per Frame Pose Data" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;fontSize=17;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="-150" y="260" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p8XZSyLTVqJCuMCk9yrC-49" value="Representation" style="swimlane;whiteSpace=wrap;html=1;fontSize=17;" parent="1" vertex="1">
          <mxGeometry x="-220" y="360" width="280" height="380" as="geometry" />
        </mxCell>
        <mxCell id="p8XZSyLTVqJCuMCk9yrC-50" value="&lt;font&gt;&lt;b&gt;Data Structure:&lt;/b&gt; Array&lt;/font&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font&gt;N items, each representing a frame.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font&gt;Frame data:&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- Bbox&lt;/div&gt;&lt;div&gt;&lt;font&gt;- Keypoints (Array)&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;fillColor=#d5e8d4;strokeColor=#82b366;" parent="p8XZSyLTVqJCuMCk9yrC-49" vertex="1">
          <mxGeometry x="10" y="30" width="260" height="340" as="geometry" />
        </mxCell>
        <mxCell id="p8XZSyLTVqJCuMCk9yrC-53" value="Analytics Data" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;fontSize=17;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="900" y="180" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p8XZSyLTVqJCuMCk9yrC-54" value="Representation" style="swimlane;whiteSpace=wrap;html=1;fontSize=17;fillStyle=solid;" parent="1" vertex="1">
          <mxGeometry x="800" y="280" width="430" height="530" as="geometry" />
        </mxCell>
        <mxCell id="p8XZSyLTVqJCuMCk9yrC-55" value="&lt;font&gt;&lt;b&gt;Data Structure:&lt;/b&gt;&amp;nbsp;Array (frames)&lt;/font&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;This structure represents the &lt;b&gt;analytical data&lt;/b&gt; that we are interested in, &lt;i&gt;per-frame&lt;/i&gt;. Since we derive these analytics from the &lt;b&gt;hold and pose data&lt;/b&gt;, we must specify how to produce them &lt;b&gt;before runtime&lt;/b&gt;. For this goal, we will use &lt;b&gt;entries&lt;/b&gt;. An entry consists of a &lt;b&gt;name&lt;/b&gt; and a &lt;b&gt;proccess&lt;/b&gt; of how to produce that piece of data from the &lt;b&gt;source data&lt;/b&gt;. We may also provide a &lt;b&gt;category&lt;/b&gt; for the piece of analysis.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;e.g.:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;name&lt;/b&gt;: &quot;Center of Mass Position&quot;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;data&lt;/b&gt;: Avg(Pose Keypoints * Keypoint Weights)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;category&lt;/b&gt;: CoM&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;At &lt;b&gt;runtime&lt;/b&gt;, these entires will be used to calculate the &lt;b&gt;resulting data&lt;/b&gt;, and this data will then be stored into the &lt;b&gt;final analytics&lt;/b&gt;.&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;fillColor=#fff2cc;strokeColor=#d6b656;" parent="p8XZSyLTVqJCuMCk9yrC-54" vertex="1">
          <mxGeometry x="10" y="30" width="410" height="490" as="geometry" />
        </mxCell>
        <mxCell id="p8XZSyLTVqJCuMCk9yrC-56" value="" style="swimlane;startSize=0;fontSize=17;" parent="1" vertex="1">
          <mxGeometry x="90" y="780" width="670" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p8XZSyLTVqJCuMCk9yrC-57" value="UI" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;" parent="p8XZSyLTVqJCuMCk9yrC-56" vertex="1">
          <mxGeometry x="30" y="10" width="20" height="30" as="geometry" />
        </mxCell>

        <mxCell id="p8XZSyLTVqJCuMCk9yrC-58" value="&lt;font&gt;User specified&lt;/font&gt;&lt;div&gt;&lt;font&gt;entries&lt;/font&gt;&lt;/div&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;fontSize=17;" parent="1" vertex="1">
          <mxGeometry x="485" y="190" width="140" height="80" as="geometry" />
